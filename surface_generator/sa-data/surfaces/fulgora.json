{
 "planet": "fulgora",
 "property_expressions": [
  "aux_basic",
  "cliff_elevation_from_elevation",
  "fulgora_cliffiness",
  "fulgora_coastline",
  "fulgora_coastline_drop",
  "fulgora_dunes",
  "fulgora_elevation",
  "fulgora_mesa",
  "fulgora_mix_oil",
  "fulgora_natural",
  "fulgora_oil_mask",
  "fulgora_pyramids",
  "fulgora_road_dust",
  "fulgora_rock",
  "fulgora_scrap_medium",
  "fulgora_sprawl",
  "fulgora_tile_ruin_conduit",
  "fulgora_tile_ruin_machinery",
  "fulgora_tile_ruin_paving",
  "fulgora_tile_ruin_walls",
  "moisture_basic",
  "temperature_basic",
  "water_base"
 ],
 "functions": {
  "amplitude_corrected_multioctave_noise": {
   "expression": "variable_persistence_multioctave_noise{x = x,y = y,seed0 = seed0,seed1 = seed1,input_scale = input_scale,output_scale = (1 - persistence) / 2 ^ octaves / (1 - persistence ^ octaves) * amplitude,offset_x = offset_x,octaves = octaves,persistence = persistence}",
   "name": "amplitude_corrected_multioctave_noise",
   "parameters": [
    "x",
    "y",
    "seed0",
    "seed1",
    "input_scale",
    "offset_x",
    "octaves",
    "persistence",
    "amplitude"
   ],
   "type": "noise-function"
  },
  "aquilo_simple_billows": {
   "expression": "abs(quick_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = seed1,input_scale = input_scale,output_scale = 1,offset_x = 10000,octaves = octaves,octave_input_scale_multiplier = 0.5,octave_output_scale_multiplier = 0.75})",
   "name": "aquilo_simple_billows",
   "parameters": [
    "seed1",
    "octaves",
    "input_scale"
   ],
   "type": "noise-function"
  },
  "aquilo_spot_noise": {
   "expression": "spot_noise{x = x,y = y,seed0 = map_seed,seed1 = seed,candidate_spot_count = count,suggested_minimum_candidate_point_spacing = 128,skip_span = 3,skip_offset = skip_offset,region_size = region_size,density_expression = density,spot_quantity_expression = radius * radius,spot_radius_expression = radius,hard_region_target_quantity = 0,spot_favorability_expression = favorability,basement_value = -1,maximum_spot_basement_radius = radius * 2}",
   "name": "aquilo_spot_noise",
   "parameters": [
    "seed",
    "count",
    "skip_offset",
    "region_size",
    "density",
    "radius",
    "favorability"
   ],
   "type": "noise-function"
  },
  "elevation_nauvis_function": {
   "expression": "min(wlc_elevation, starting_lake)",
   "local_expressions": {
    "elevation_magnitude": 20,
    "nauvis_main": "elevation_magnitude * (lerp(0.5 * added_cliff_elevation - 0.6,1.9 * added_cliff_elevation + 1.6,0.1 + 0.5 * nauvis_bridges)+ 0.25 * nauvis_detail+ 3 * nauvis_macro * starting_macro_multiplier)",
    "starting_island": "nauvis_main + elevation_magnitude * (2.5 - distance * segmentation_multiplier / 200)",
    "starting_lake": "elevation_magnitude * (-3 + (starting_lake_distance + starting_lake_noise) / 8) / 8",
    "starting_lake_distance": "distance_from_nearest_point{x = x, y = y, points = starting_lake_positions, maximum_distance = 1024}",
    "starting_lake_noise": "quick_multioctave_noise_persistence{x = x,y = y,seed0 = map_seed,seed1 = 14,input_scale = 1/8,output_scale = 0.8,octaves = 4,octave_input_scale_multiplier = 0.5,persistence = 0.68}",
    "starting_macro_multiplier": "clamp(distance * nauvis_segmentation_multiplier / 2000, 0, 1)",
    "wlc_amplitude": 2,
    "wlc_elevation": "max(nauvis_main - water_level * wlc_amplitude, starting_island)"
   },
   "name": "elevation_nauvis_function",
   "parameters": [
    "added_cliff_elevation"
   ],
   "type": "noise-function"
  },
  "quick_multioctave_noise_persistence": {
   "expression": "quick_multioctave_noise{x = x,y = y,seed0 = seed0,seed1 = seed1,input_scale = input_scale * octave_input_scale_multiplier ^ (octaves - 1),output_scale = output_scale * 2 ^ (octaves - 1),octaves = octaves,octave_output_scale_multiplier = persistence,octave_input_scale_multiplier = 1 / octave_input_scale_multiplier}",
   "name": "quick_multioctave_noise_persistence",
   "parameters": [
    "x",
    "y",
    "seed0",
    "seed1",
    "input_scale",
    "output_scale",
    "octaves",
    "octave_input_scale_multiplier",
    "persistence"
   ],
   "type": "noise-function"
  },
  "slider_rescale": {
   "expression": "2^(log2(slider_value)/log2(6)*log2(n))",
   "name": "slider_rescale",
   "parameters": [
    "slider_value",
    "n"
   ],
   "type": "noise-function"
  },
  "slider_to_linear": {
   "expression": "min + 0.5 * (max - min) * (1 + log2(slider_value) / log2(6))",
   "name": "slider_to_linear",
   "parameters": [
    "slider_value",
    "min",
    "max"
   ],
   "type": "noise-function"
  },
  "starting_spot_at_angle": {
   "expression": "1 - (delta_x * delta_x + delta_y * delta_y) ^ 0.5 / radius",
   "local_expressions": {
    "angle_rad": "angle / 180 * pi",
    "delta_x": "distance * sin(angle_rad) - x_from_start + x_distortion",
    "delta_y": "-distance * cos(angle_rad) - y_from_start + y_distortion"
   },
   "name": "starting_spot_at_angle",
   "parameters": [
    "angle",
    "distance",
    "radius",
    "x_distortion",
    "y_distortion"
   ],
   "type": "noise-function"
  },
  "water_base": {
   "expression": "if(max_elevation >= fulgora_elevation, influence * min(max_elevation - fulgora_elevation, 1), -inf)",
   "name": "water_base",
   "parameters": [
    "max_elevation",
    "influence"
   ],
   "type": "noise-function"
  }
 },
 "expressions": {
  "aquilo_angle": {
   "expression": "map_seed_normalized * 3600",
   "name": "aquilo_angle",
   "type": "noise-expression"
  },
  "aquilo_aux": {
   "expression": "0.5 + multioctave_noise{x = x + aquilo_wobble_x * 300 / aquilo_aux_scale,y = y + aquilo_wobble_y * 300 / aquilo_aux_scale,seed0 = map_seed,seed1 = 14243,octaves = 3,persistence = 0.7,input_scale = aquilo_aux_scale / 25,output_scale = 1}",
   "name": "aquilo_aux",
   "type": "noise-expression"
  },
  "aquilo_aux_scale": {
   "expression": "aquilo_segmentation_multiplier * 1.5",
   "name": "aquilo_aux_scale",
   "type": "noise-expression"
  },
  "aquilo_crude_oil_spots": {
   "expression": "aquilo_spot_noise{seed = 567,count = 4,skip_offset = 0,region_size = 600 + 400 / control:aquilo_crude_oil:frequency,density = 1,radius = aquilo_spot_size * sqrt(control:aquilo_crude_oil:size),favorability = 1}",
   "name": "aquilo_crude_oil_spots",
   "type": "noise-expression"
  },
  "aquilo_elevation": {
   "expression": "lerp(blended, maxed, 0.4)",
   "local_expressions": {
    "blended": "lerp(formation_clumped, formation_broken, 0.4)",
    "formation_broken": "-20+ 8 * max(aquilo_island_peaks * 1.1, min(0., random_island_peaks - 0.2))+ 13 * (pow(voronoi_large * max(0, voronoi_large_cell * 1.2 - 0.2) + 0.5 * voronoi_small * max(0, aux + 0.1), 0.5))",
    "formation_clumped": "-25+ 12 * max(aquilo_island_peaks, random_island_peaks)+ 15 * tri_crack",
    "maxed": "max(formation_clumped, formation_broken)",
    "random_island_peaks": "abs(amplitude_corrected_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 1000,input_scale = segmentation_mult / 1.2,offset_x = -10000,octaves = 6,persistence = 0.8,amplitude = 1})",
    "segmentation_mult": "aquilo_segmentation_multiplier / 25",
    "tri_crack": "min(aquilo_simple_billows{seed1 = 2000, octaves = 3, input_scale = segmentation_mult / 1.5},aquilo_simple_billows{seed1 = 3000, octaves = 3, input_scale = segmentation_mult / 1.2},aquilo_simple_billows{seed1 = 4000, octaves = 3, input_scale = segmentation_mult})",
    "voronoi_large": "voronoi_facet_noise{   x = x + aquilo_wobble_x * 2,y = y + aquilo_wobble_y * 2,seed0 = map_seed,seed1 = 'aquilo-cracks',grid_size = 24,distance_type = 'euclidean',jitter = 1}",
    "voronoi_large_cell": "voronoi_cell_id{  x = x + aquilo_wobble_x * 2,y = y + aquilo_wobble_y * 2,seed0 = map_seed,seed1 = 'aquilo-cracks',grid_size = 24,distance_type = 'euclidean',jitter = 1}",
    "voronoi_small": "voronoi_facet_noise{   x = x + aquilo_wobble_x * 2,y = y + aquilo_wobble_y * 2,seed0 = map_seed,seed1 = 'aquilo-cracks',grid_size = 10,distance_type = 'euclidean',jitter = 1}"
   },
   "name": "aquilo_elevation",
   "type": "noise-expression"
  },
  "aquilo_flourine_vent_spots": {
   "expression": "aquilo_spot_noise{seed = 567,count = 2,skip_offset = 2,region_size = 600 + 400 / control:fluorine_vent:frequency,density = 1,radius = aquilo_spot_size * 1.5 * sqrt(control:fluorine_vent:size),favorability = 1}",
   "name": "aquilo_flourine_vent_spots",
   "type": "noise-expression"
  },
  "aquilo_island_peaks": {
   "expression": "max(1.7 * (0.3 + aquilo_starting_island),1.5 * (0.5 + max(aquilo_starting_crude_oil, aquilo_crude_oil_spots,aquilo_starting_lithium_brine, aquilo_lithium_brine_spots,aquilo_starting_flourine_vent, aquilo_flourine_vent_spots)))",
   "name": "aquilo_island_peaks",
   "type": "noise-expression"
  },
  "aquilo_lithium_brine_spots": {
   "expression": "aquilo_spot_noise{seed = 567,count = 3,skip_offset = 1,region_size = 600 + 400 / control:lithium_brine:frequency,density = 1,radius = aquilo_spot_size * 1.2 * sqrt(control:lithium_brine:size),favorability = 1}",
   "name": "aquilo_lithium_brine_spots",
   "type": "noise-expression"
  },
  "aquilo_segmentation_multiplier": {
   "expression": "1",
   "name": "aquilo_segmentation_multiplier",
   "type": "noise-expression"
  },
  "aquilo_spot_size": {
   "expression": "30",
   "name": "aquilo_spot_size",
   "type": "noise-expression"
  },
  "aquilo_starting_crude_oil": {
   "expression": "starting_spot_at_angle{angle = aquilo_angle, distance = 40, radius = aquilo_spot_size * 0.8, x_distortion = 0, y_distortion = 0}",
   "name": "aquilo_starting_crude_oil",
   "type": "noise-expression"
  },
  "aquilo_starting_flourine_vent": {
   "expression": "starting_spot_at_angle{angle = aquilo_angle + 240, distance = 160, radius = aquilo_spot_size * 0.6, x_distortion = 0, y_distortion = 0}",
   "name": "aquilo_starting_flourine_vent",
   "type": "noise-expression"
  },
  "aquilo_starting_island": {
   "expression": "1 - distance * (aquilo_segmentation_multiplier / 100)",
   "name": "aquilo_starting_island",
   "type": "noise-expression"
  },
  "aquilo_starting_lithium_brine": {
   "expression": "starting_spot_at_angle{angle = aquilo_angle + 120, distance = 80, radius = aquilo_spot_size * 0.6, x_distortion = 0, y_distortion = 0}",
   "name": "aquilo_starting_lithium_brine",
   "type": "noise-expression"
  },
  "aquilo_temperature": {
   "expression": "temperature_basic - 100",
   "name": "aquilo_temperature",
   "type": "noise-expression"
  },
  "aquilo_wobble_x": {
   "expression": "multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 12243,octaves = 3,persistence = 0.65,input_scale = aquilo_aux_scale / 100,output_scale = 0.35}",
   "name": "aquilo_wobble_x",
   "type": "noise-expression"
  },
  "aquilo_wobble_y": {
   "expression": "multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 13243,octaves = 3,persistence = 0.65,input_scale = aquilo_aux_scale / 100,output_scale = 0.35}",
   "name": "aquilo_wobble_y",
   "type": "noise-expression"
  },
  "aux": {
   "expression": "aux_nauvis",
   "localised_name": [
    "noise-expression.aux_nauvis"
   ],
   "name": "aux",
   "type": "noise-expression"
  },
  "aux_basic": {
   "expression": "clamp(0.5 + var('control:aux_basic:bias') + aux_noise, 0, 1)",
   "name": "aux_basic",
   "type": "noise-expression"
  },
  "aux_nauvis": {
   "expression": "clamp(0.5 + var('control:aquilo_aux:bias') + 0.06 * (nauvis_plateaus - 0.4)+ aux_noise,0, 1)",
   "name": "aux_nauvis",
   "type": "noise-expression"
  },
  "aux_noise": {
   "expression": "quick_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 7,octaves = 4,input_scale = var('control:aquilo_aux:frequency') / 2048,output_scale = 0.25,offset_x = 20000 / var('control:aquilo_aux:frequency'),octave_output_scale_multiplier = 0.5,octave_input_scale_multiplier = 3}",
   "name": "aux_noise",
   "type": "noise-expression"
  },
  "cliff_elevation_from_elevation": {
   "expression": "aquilo_elevation",
   "name": "cliff_elevation_from_elevation",
   "type": "noise-expression"
  },
  "distance": {
   "expression": "distance_from_nearest_point{x = x, y = y, points = starting_positions}",
   "name": "distance",
   "type": "noise-expression"
  },
  "elevation": {
   "expression": "elevation_nauvis",
   "intended_property": "elevation",
   "localised_name": [
    "noise-expression.elevation_nauvis"
   ],
   "name": "elevation",
   "type": "noise-expression"
  },
  "elevation_nauvis": {
   "expression": "elevation_nauvis_function(nauvis_hills_plateaus)",
   "name": "elevation_nauvis",
   "type": "noise-expression"
  },
  "forest_path_billows": {
   "expression": "abs(multioctave_noise{x = x,y = y,persistence = 0.5,seed0 = map_seed,seed1 = 1800,octaves = 4,input_scale = nauvis_segmentation_multiplier / 100})",
   "name": "forest_path_billows",
   "type": "noise-expression"
  },
  "forest_paths": {
   "expression": "(forest_path_billows - 0.07) * 3",
   "name": "forest_paths",
   "type": "noise-expression"
  },
  "fulgora_artificial_cap": {
   "expression": "0.25",
   "name": "fulgora_artificial_cap",
   "type": "noise-expression"
  },
  "fulgora_artificial_mask": {
   "expression": "1 - max(fulgora_oil_mask, fulgora_natural_and_mesa_mask)",
   "name": "fulgora_artificial_mask",
   "type": "noise-expression"
  },
  "fulgora_basis": {
   "expression": "multioctave_noise{x = fulgora_wx,y = fulgora_wy,persistence = 0.5,seed0 = map_seed,seed1 = 'fulgora_basis',octaves = 6,input_scale = 128 / fulgora_grid / 7.5,output_scale = 0.5}",
   "name": "fulgora_basis",
   "type": "noise-expression"
  },
  "fulgora_basis_oil": {
   "expression": "multioctave_noise{x = x + 1.5 * fulgora_wobble_x,y = y + 1.5 * fulgora_wobble_y,persistence = 0.65,seed0 = map_seed,seed1 = 'fulgora_basis_oil',octaves = 4,input_scale = 1 / 10}",
   "name": "fulgora_basis_oil",
   "type": "noise-expression"
  },
  "fulgora_blanks": {
   "expression": "fulgora_cells < 0.33",
   "name": "fulgora_blanks",
   "type": "noise-expression"
  },
  "fulgora_cells": {
   "expression": "voronoi_cell_id{x = fulgora_wx,y = fulgora_wy,seed0 = map_seed,seed1 = 'fulgora_cells',grid_size = fulgora_grid,distance_type = 'manhattan',jitter = fulgora_jitter}",
   "name": "fulgora_cells",
   "type": "noise-expression"
  },
  "fulgora_cliffiness": {
   "expression": "8 * slider_rescale(cliff_richness, 20)* (fulgora_road_pyramids - 0.1 + max(0, 1 - 10 * fulgora_wobble_mask))- 1000 * safe_start_excluder_h",
   "local_expressions": {
    "safe_start_excluder_h": "min(x_from_start < fulgora_grid, x_from_start > -fulgora_grid, y_from_start < 5, y_from_start > -5)"
   },
   "name": "fulgora_cliffiness",
   "type": "noise-expression"
  },
  "fulgora_coastline": {
   "expression": "80",
   "name": "fulgora_coastline",
   "type": "noise-expression"
  },
  "fulgora_coastline_drop": {
   "expression": "20",
   "name": "fulgora_coastline_drop",
   "type": "noise-expression"
  },
  "fulgora_dunes": {
   "expression": "0.66 - abs(multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_dunes',octaves = 3,input_scale = 1/6 })",
   "name": "fulgora_dunes",
   "type": "noise-expression"
  },
  "fulgora_elevation": {
   "expression": "fulgora_pre_elevation + ((fulgora_sand_basins > 0) - 0.5) * fulgora_coastline_drop",
   "name": "fulgora_elevation",
   "type": "noise-expression"
  },
  "fulgora_grid": {
   "expression": "175 - slider_to_linear(control:fulgora_islands:frequency, -50, 50)",
   "name": "fulgora_grid",
   "type": "noise-expression"
  },
  "fulgora_jitter": {
   "expression": "0.6",
   "name": "fulgora_jitter",
   "type": "noise-expression"
  },
  "fulgora_mesa": {
   "expression": "fulgora_cells > 0.75",
   "name": "fulgora_mesa",
   "type": "noise-expression"
  },
  "fulgora_mix_moats": {
   "expression": "lerp(fulgora_mix_natural, fulgora_moats, max(fulgora_vaults_and_starting_vault, fulgora_starting_mask))",
   "name": "fulgora_mix_moats",
   "type": "noise-expression"
  },
  "fulgora_mix_natural": {
   "expression": "max(fulgora_natural, fulgora_mix_pyramids)",
   "name": "fulgora_mix_natural",
   "type": "noise-expression"
  },
  "fulgora_mix_oil": {
   "expression": "lerp(fulgora_mix_spots, min(-0.01, fulgora_mix_spots - 0.4 + 0.6 * fulgora_basis_oil), fulgora_oil_mask)",
   "name": "fulgora_mix_oil",
   "type": "noise-expression"
  },
  "fulgora_mix_pyramids": {
   "expression": "min(fulgora_artificial_cap, (fulgora_sprawl_pyramids - 0.185) * 4)",
   "name": "fulgora_mix_pyramids",
   "type": "noise-expression"
  },
  "fulgora_mix_spots": {
   "expression": "max(fulgora_mix_moats, fulgora_vault_spots) + max(0, fulgora_starting_cone - 0.8)",
   "name": "fulgora_mix_spots",
   "type": "noise-expression"
  },
  "fulgora_moats": {
   "expression": "min(fulgora_artificial_cap, 1.5 * max(-0.05 -fulgora_vault_pyramids_and_start * 2, (fulgora_vault_pyramids_and_start - 0.35) * 2))",
   "name": "fulgora_moats",
   "type": "noise-expression"
  },
  "fulgora_natural": {
   "expression": "fulgora_basis * 2 * slider_rescale(control:fulgora_islands:size,  2) - 0.85",
   "name": "fulgora_natural",
   "type": "noise-expression"
  },
  "fulgora_natural_and_mesa_mask": {
   "expression": "max(fulgora_natural_mask, fulgora_mesa)",
   "name": "fulgora_natural_and_mesa_mask",
   "type": "noise-expression"
  },
  "fulgora_natural_mask": {
   "expression": "max(min(fulgora_natural > fulgora_mix_pyramids, 1 - fulgora_vaults_and_starting_vault), fulgora_starting_mask)",
   "name": "fulgora_natural_mask",
   "type": "noise-expression"
  },
  "fulgora_oil_mask": {
   "expression": "fulgora_mix_spots < 0",
   "name": "fulgora_oil_mask",
   "type": "noise-expression"
  },
  "fulgora_ox": {
   "expression": "x + fulgora_grid / 2",
   "name": "fulgora_ox",
   "type": "noise-expression"
  },
  "fulgora_oy": {
   "expression": "y + fulgora_grid / 2",
   "name": "fulgora_oy",
   "type": "noise-expression"
  },
  "fulgora_pre_elevation": {
   "expression": "fulgora_sand_basins * 60 + fulgora_coastline",
   "name": "fulgora_pre_elevation",
   "type": "noise-expression"
  },
  "fulgora_pyramids": {
   "expression": "voronoi_pyramid_noise{x = fulgora_wx,y = fulgora_wy,seed0 = map_seed,seed1 = 'fulgora_cells',grid_size = fulgora_grid,distance_type = 'manhattan',jitter = fulgora_jitter}",
   "name": "fulgora_pyramids",
   "type": "noise-expression"
  },
  "fulgora_pyramids_banding": {
   "expression": "(fulgora_pyramids * 8) % 1",
   "name": "fulgora_pyramids_banding",
   "type": "noise-expression"
  },
  "fulgora_road_cells": {
   "expression": "voronoi_cell_id{x = x,y = y,seed0 = map_seed,seed1 = 'fulgora_road_cells',grid_size = fulgora_grid / 3,distance_type = 'chebyshev',jitter = fulgora_road_jitter}",
   "name": "fulgora_road_cells",
   "type": "noise-expression"
  },
  "fulgora_road_dust": {
   "expression": "(fulgora_road_pyramids < 0.08) * 0.9 - fulgora_road_paving_2c",
   "name": "fulgora_road_dust",
   "type": "noise-expression"
  },
  "fulgora_road_jitter": {
   "expression": "1",
   "name": "fulgora_road_jitter",
   "type": "noise-expression"
  },
  "fulgora_road_paving_2": {
   "expression": "max((fulgora_road_pyramids < 0.05) * 0.9,(fulgora_pyramids_banding < 0.1) * 0.85 * (fulgora_road_cells < 0.6) * (fulgora_road_cells > 0.25),(fulgora_spots_banding < 0.1) * 0.85 * (fulgora_road_cells < 0.25),(fulgora_structure_facets < 0.1) * 0.85 * (fulgora_road_cells > 0.6))",
   "name": "fulgora_road_paving_2",
   "type": "noise-expression"
  },
  "fulgora_road_paving_2b": {
   "expression": "lerp(fulgora_road_paving_2, (fulgora_structure_facets < 0.2) * 0.9, fulgora_structure_cells > 0.8)",
   "name": "fulgora_road_paving_2b",
   "type": "noise-expression"
  },
  "fulgora_road_paving_2c": {
   "expression": "lerp(fulgora_road_paving_2b, (fulgora_spots_prebanding > 1) * 0.9, fulgora_spots_prebanding < 1.3)",
   "name": "fulgora_road_paving_2c",
   "type": "noise-expression"
  },
  "fulgora_road_paving_thin": {
   "expression": "max((fulgora_road_pyramids < 0.03) * 0.9, (fulgora_structure_facets < 0.06) * 0.5)",
   "name": "fulgora_road_paving_thin",
   "type": "noise-expression"
  },
  "fulgora_road_pyramids": {
   "expression": "voronoi_pyramid_noise{x = x,y = y,seed0 = map_seed,seed1 = 'fulgora_road_cells',grid_size = fulgora_grid / 3,distance_type = 'chebyshev',jitter = fulgora_road_jitter}",
   "name": "fulgora_road_pyramids",
   "type": "noise-expression"
  },
  "fulgora_rock": {
   "expression": "0.33 + abs(multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_rock',octaves = 4,input_scale = 1/3 })",
   "name": "fulgora_rock",
   "type": "noise-expression"
  },
  "fulgora_ruins_paving": {
   "expression": "abs(multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_ruins_paving',octaves = 3,input_scale = 1/16})",
   "name": "fulgora_ruins_paving",
   "type": "noise-expression"
  },
  "fulgora_ruins_walls": {
   "expression": "0.66 - abs(multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_ruins_walls',octaves = 3,input_scale = 1/6})",
   "name": "fulgora_ruins_walls",
   "type": "noise-expression"
  },
  "fulgora_sand_basins": {
   "expression": "min(fulgora_mix_oil, 0.6 - fulgora_mix_oil)",
   "name": "fulgora_sand_basins",
   "type": "noise-expression"
  },
  "fulgora_scrap_medium": {
   "expression": "multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_scrap_medium',octaves = 3,input_scale = 1/18}",
   "name": "fulgora_scrap_medium",
   "type": "noise-expression"
  },
  "fulgora_spots": {
   "expression": "voronoi_spot_noise{x = fulgora_ox + fulgora_wobble_x / 2,y = fulgora_oy + fulgora_wobble_y / 2,seed0 = map_seed,seed1 = 'fulgora_cells',grid_size = fulgora_grid,distance_type = 'euclidean',jitter = fulgora_jitter}",
   "name": "fulgora_spots",
   "type": "noise-expression"
  },
  "fulgora_spots_banding": {
   "expression": "fulgora_spots_prebanding % 1",
   "name": "fulgora_spots_banding",
   "type": "noise-expression"
  },
  "fulgora_spots_inv": {
   "expression": "1 - fulgora_spots",
   "name": "fulgora_spots_inv",
   "type": "noise-expression"
  },
  "fulgora_spots_prebanding": {
   "expression": "min(fulgora_spots, (1 - fulgora_starting_vault_cone) / 2) * 9 + 0.5",
   "name": "fulgora_spots_prebanding",
   "type": "noise-expression"
  },
  "fulgora_sprawl": {
   "expression": "(fulgora_cells > 0.5) - fulgora_mesa",
   "name": "fulgora_sprawl",
   "type": "noise-expression"
  },
  "fulgora_sprawl_pyramids": {
   "expression": "fulgora_pyramids* (fulgora_sprawl+ fulgora_mesa * min(1, abs(0.9 - 0.2 * fulgora_basis_oil + 0.05 * fulgora_rock)))",
   "name": "fulgora_sprawl_pyramids",
   "type": "noise-expression"
  },
  "fulgora_starting_cone": {
   "expression": "max(0, starting_spot_at_angle{angle = map_seed / 360,distance = fulgora_grid / 30,radius = fulgora_grid / 1.8,x_distortion = 1 * fulgora_wobble_x,y_distortion = 1 * fulgora_wobble_y},starting_spot_at_angle{angle = map_seed / 360,distance = 1,radius = fulgora_grid / 4,x_distortion = 0.25 * fulgora_wobble_x,y_distortion = 0.25 * fulgora_wobble_y})",
   "name": "fulgora_starting_cone",
   "type": "noise-expression"
  },
  "fulgora_starting_mask": {
   "expression": "(fulgora_starting_cone - fulgora_starting_vault_cone) > 0",
   "name": "fulgora_starting_mask",
   "type": "noise-expression"
  },
  "fulgora_starting_vault_cone": {
   "expression": "max(0, starting_spot_at_angle{angle = map_seed / 360 + 180,distance = fulgora_grid / 1.8,radius = fulgora_grid / 1.8,x_distortion = 1 * fulgora_wobble_x,y_distortion = 1 * fulgora_wobble_y})",
   "name": "fulgora_starting_vault_cone",
   "type": "noise-expression"
  },
  "fulgora_starting_vault_mask": {
   "expression": "(fulgora_starting_vault_cone - fulgora_starting_cone) > 0",
   "name": "fulgora_starting_vault_mask",
   "type": "noise-expression"
  },
  "fulgora_structure_cells": {
   "expression": "voronoi_cell_id{x = x,y = y * 0.8,seed0 = map_seed,seed1 = 'fulgora_structure_cells',grid_size = fulgora_grid / 8,distance_type = 'minkowski3',jitter = fulgora_structure_jitter}",
   "name": "fulgora_structure_cells",
   "type": "noise-expression"
  },
  "fulgora_structure_facets": {
   "expression": "voronoi_facet_noise{x = x,y = y * 0.8,seed0 = map_seed,seed1 = 'fulgora_structure_cells',grid_size = fulgora_grid / 8,distance_type = 'minkowski3',jitter = fulgora_structure_jitter}",
   "name": "fulgora_structure_facets",
   "type": "noise-expression"
  },
  "fulgora_structure_jitter": {
   "expression": "0.8",
   "name": "fulgora_structure_jitter",
   "type": "noise-expression"
  },
  "fulgora_structure_subnoise": {
   "expression": "multioctave_noise{x = x + 10000 * fulgora_structure_cells,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_structure_subnoise',octaves = 3,input_scale = 1/12}",
   "name": "fulgora_structure_subnoise",
   "type": "noise-expression"
  },
  "fulgora_tile_ruin_conduit": {
   "expression": "fulgora_artificial_mask * (fulgora_ruins_walls+ fulgora_structure_subnoise + 2 * fulgora_structure_facets- fulgora_road_paving_2c+ 0.2+ 0.3 * fulgora_vaults_and_starting_vault) - fulgora_road_paving_2c",
   "name": "fulgora_tile_ruin_conduit",
   "type": "noise-expression"
  },
  "fulgora_tile_ruin_machinery": {
   "expression": "fulgora_artificial_mask * (-fulgora_ruins_walls+ 1.25 * fulgora_structure_subnoise+ 2.5 * fulgora_structure_facets- fulgora_road_paving_2c- 0.2+ 0.3 * fulgora_vaults_and_starting_vault+ 2 * (fulgora_spots_prebanding < 1)) - fulgora_road_paving_2c",
   "name": "fulgora_tile_ruin_machinery",
   "type": "noise-expression"
  },
  "fulgora_tile_ruin_paving": {
   "expression": "max(fulgora_natural_and_mesa_mask * (3 * fulgora_ruins_paving * fulgora_road_paving_thin - 0.5),fulgora_artificial_mask * (4 * fulgora_road_paving_2c + fulgora_ruins_paving - 1))",
   "name": "fulgora_tile_ruin_paving",
   "type": "noise-expression"
  },
  "fulgora_tile_ruin_walls": {
   "expression": "max(fulgora_natural_and_mesa_mask * (2 * fulgora_ruins_walls + fulgora_ruins_paving - 0.5),fulgora_artificial_mask * (0.25 * fulgora_ruins_walls+ 0.25 * fulgora_structure_subnoise- 4 * fulgora_structure_facets- fulgora_road_paving_2c+ 2.5))",
   "name": "fulgora_tile_ruin_walls",
   "type": "noise-expression"
  },
  "fulgora_vault_pyramids": {
   "expression": "max(fulgora_vaults * fulgora_pyramids, 0.5 * fulgora_starting_vault_cone)",
   "name": "fulgora_vault_pyramids",
   "type": "noise-expression"
  },
  "fulgora_vault_pyramids_and_start": {
   "expression": "max(fulgora_vault_pyramids, 0.5 * fulgora_starting_cone)",
   "name": "fulgora_vault_pyramids_and_start",
   "type": "noise-expression"
  },
  "fulgora_vault_spots": {
   "expression": "min(fulgora_artificial_cap,-10 + 11.5 * max(fulgora_vaults * fulgora_spots_inv,fulgora_starting_vault_mask * (0.5 + 0.5 * fulgora_starting_vault_cone),fulgora_starting_mask * (0.5 + 0.5 * fulgora_starting_cone)))",
   "name": "fulgora_vault_spots",
   "type": "noise-expression"
  },
  "fulgora_vaults": {
   "expression": "1 - fulgora_blanks - fulgora_sprawl - fulgora_mesa",
   "name": "fulgora_vaults",
   "type": "noise-expression"
  },
  "fulgora_vaults_and_starting_vault": {
   "expression": "max(fulgora_vaults, fulgora_starting_vault_mask)",
   "name": "fulgora_vaults_and_starting_vault",
   "type": "noise-expression"
  },
  "fulgora_wobble_influence": {
   "expression": "multioctave_noise{x = x,y = y,persistence = 0.5,seed0 = map_seed,seed1 = 1,octaves = 3,input_scale = 128 / fulgora_grid / 20 ,output_scale = 3}",
   "name": "fulgora_wobble_influence",
   "type": "noise-expression"
  },
  "fulgora_wobble_mask": {
   "expression": "clamp(fulgora_wobble_influence + 0.6, 0, 1)",
   "name": "fulgora_wobble_mask",
   "type": "noise-expression"
  },
  "fulgora_wobble_x": {
   "expression": "multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_wobble_x',octaves = 4,input_scale = 5 / fulgora_grid,output_scale = fulgora_grid * 0.07}",
   "name": "fulgora_wobble_x",
   "type": "noise-expression"
  },
  "fulgora_wobble_y": {
   "expression": "multioctave_noise{x = x,y = y,persistence = 0.7,seed0 = map_seed,seed1 = 'fulgora_wobble_y',octaves = 4,input_scale = 5 / fulgora_grid,output_scale = fulgora_grid * 0.07}",
   "name": "fulgora_wobble_y",
   "type": "noise-expression"
  },
  "fulgora_wx": {
   "expression": "fulgora_ox + fulgora_wobble_x * fulgora_wobble_mask",
   "name": "fulgora_wx",
   "type": "noise-expression"
  },
  "fulgora_wy": {
   "expression": "fulgora_oy + fulgora_wobble_y * fulgora_wobble_mask",
   "name": "fulgora_wy",
   "type": "noise-expression"
  },
  "moisture": {
   "expression": "moisture_nauvis",
   "localised_name": [
    "noise-expression.moisture_nauvis"
   ],
   "name": "moisture",
   "type": "noise-expression"
  },
  "moisture_adjusted_bias": {
   "expression": "lerp(base_bias, starting_bias, starting_bias_region)",
   "local_expressions": {
    "base_bias": "var('control:moisture:bias')",
    "starting_bias": "lerp(base_bias, starting_bias_change, starting_bias_magnitude * 1.1)",
    "starting_bias_change": "slider_to_linear(var('control:starting_area_moisture:size'), -0.5, 0.5)",
    "starting_bias_magnitude": "abs(2 * starting_bias_change)",
    "starting_bias_region": "clamp(2 - var('control:starting_area_moisture:frequency') / 400 * distance, 0, 1)"
   },
   "name": "moisture_adjusted_bias",
   "type": "noise-expression"
  },
  "moisture_basic": {
   "expression": "clamp(0.45 + moisture_adjusted_bias + moisture_noise, 0, 1)",
   "name": "moisture_basic",
   "type": "noise-expression"
  },
  "moisture_nauvis": {
   "expression": "max(min(moisture_main, 0.45), moisture_main - 0.2 * max(0, 1 - trees_forest_path_cutout * 1.5))",
   "local_expressions": {
    "moisture_main": "clamp(0.4 + moisture_adjusted_bias + moisture_noise- 0.08 * (nauvis_plateaus - 0.6),0, 1)"
   },
   "name": "moisture_nauvis",
   "type": "noise-expression"
  },
  "moisture_noise": {
   "expression": "quick_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 6,octaves = 4,input_scale = var('control:moisture_basic:frequency') / 256,output_scale = 0.125,offset_x = 30000 / var('control:moisture_basic:frequency'),octave_output_scale_multiplier = 1.5,octave_input_scale_multiplier = 1/3}",
   "name": "moisture_noise",
   "type": "noise-expression"
  },
  "nauvis_bridge_billows": {
   "expression": "abs(multioctave_noise{x = x,y = y,persistence = 0.5,seed0 = map_seed,seed1 = 700,octaves = 4,input_scale = nauvis_segmentation_multiplier / 150})",
   "name": "nauvis_bridge_billows",
   "type": "noise-expression"
  },
  "nauvis_bridge_paths": {
   "expression": "(nauvis_bridge_billows - 0.07) * 5",
   "name": "nauvis_bridge_paths",
   "type": "noise-expression"
  },
  "nauvis_bridges": {
   "expression": "1 - 0.1 * nauvis_bridge_billows - 0.9 * max(0, -0.1 + nauvis_bridge_billows)",
   "name": "nauvis_bridges",
   "type": "noise-expression"
  },
  "nauvis_detail": {
   "expression": "variable_persistence_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 600,input_scale = nauvis_segmentation_multiplier / 14,output_scale = 0.03,offset_x = 10000 / nauvis_segmentation_multiplier,octaves = 5,persistence = nauvis_persistance}",
   "name": "nauvis_detail",
   "type": "noise-expression"
  },
  "nauvis_hills": {
   "expression": "abs(multioctave_noise{x = x,y = y,persistence = 0.5,seed0 = map_seed,seed1 = 900,octaves = 4,input_scale = nauvis_segmentation_multiplier / 90})",
   "name": "nauvis_hills",
   "type": "noise-expression"
  },
  "nauvis_hills_cliff_level": {
   "expression": "clamp(0.65 + basis_noise{x = x,y = y,seed0 = map_seed,seed1 = 99584,input_scale = nauvis_segmentation_multiplier/500,output_scale = 0.6}, 0.15, 1.15)",
   "name": "nauvis_hills_cliff_level",
   "type": "noise-expression"
  },
  "nauvis_hills_paths": {
   "expression": "(nauvis_hills - 0.1) * 3",
   "name": "nauvis_hills_paths",
   "type": "noise-expression"
  },
  "nauvis_hills_plateaus": {
   "expression": "0.1 * nauvis_hills + 0.8 * nauvis_plateaus",
   "name": "nauvis_hills_plateaus",
   "type": "noise-expression"
  },
  "nauvis_macro": {
   "expression": "multioctave_noise{x = x,y = y,persistence = 0.6,seed0 = map_seed,seed1 = 1000,octaves = 2,input_scale = nauvis_segmentation_multiplier / 1600}* max(0, multioctave_noise{x = x,y = y,persistence = 0.6,seed0 = map_seed,seed1 = 1100,octaves = 1,input_scale = nauvis_segmentation_multiplier / 1600})",
   "name": "nauvis_macro",
   "type": "noise-expression"
  },
  "nauvis_persistance": {
   "expression": "clamp(amplitude_corrected_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 500,octaves = 5,input_scale = nauvis_segmentation_multiplier / 2,offset_x = 10000 / nauvis_segmentation_multiplier,persistence = 0.7,amplitude = 0.5} + 0.55,0.5, 0.65)",
   "name": "nauvis_persistance",
   "type": "noise-expression"
  },
  "nauvis_plateaus": {
   "expression": "0.5 + clamp((nauvis_hills - nauvis_hills_cliff_level) * 10, -0.5, 0.5)",
   "name": "nauvis_plateaus",
   "type": "noise-expression"
  },
  "nauvis_segmentation_multiplier": {
   "expression": "1.5 * control:water:frequency",
   "name": "nauvis_segmentation_multiplier",
   "type": "noise-expression"
  },
  "segmentation_multiplier": {
   "expression": "control:water:frequency",
   "name": "segmentation_multiplier",
   "type": "noise-expression"
  },
  "temperature_basic": {
   "expression": "clamp(sea_level_temperature + var('control:aquilo_temperature:bias') + quick_multioctave_noise{x = x,y = y,seed0 = map_seed,seed1 = 5,octaves = 4,input_scale = var('control:aquilo_temperature:frequency') / 32,output_scale = 1/20,offset_x = 40000 / var('control:aquilo_temperature:frequency'),octave_output_scale_multiplier = 3,octave_input_scale_multiplier = 1/3},-20, 50)",
   "local_expressions": {
    "sea_level_temperature": 15
   },
   "name": "temperature_basic",
   "type": "noise-expression"
  },
  "trees_forest_path_cutout": {
   "expression": "min(nauvis_bridge_paths, nauvis_hills_paths, forest_paths)",
   "name": "trees_forest_path_cutout",
   "type": "noise-expression"
  },
  "water_level": {
   "expression": "10 * log2(control:water:size)",
   "name": "water_level",
   "type": "noise-expression"
  },
  "oil-ocean-deep": {
   "name": "oil-ocean-deep",
   "expression": "100 * fulgora_oil_mask * water_base(fulgora_coastline - 50 - fulgora_coastline_drop / 2, 2000)"
  },
  "oil-ocean-shallow": {
   "name": "oil-ocean-shallow",
   "expression": "50 * fulgora_oil_mask * water_base(fulgora_coastline, 1000)"
  },
  "fulgoran-paving": {
   "name": "fulgoran-paving",
   "expression": "fulgora_tile_ruin_paving"
  },
  "fulgoran-dust": {
   "name": "fulgoran-dust",
   "expression": "fulgora_scrap_medium + max(0, fulgora_natural, 2 * fulgora_mesa * fulgora_pyramids) * 2 - 0.9 + fulgora_rock + fulgora_road_dust * fulgora_sprawl"
  },
  "fulgoran-dunes": {
   "name": "fulgoran-dunes",
   "expression": "1 + fulgora_dunes"
  },
  "fulgoran-sand": {
   "name": "fulgoran-sand",
   "expression": "1 - fulgora_dunes"
  },
  "fulgoran-rock": {
   "name": "fulgoran-rock",
   "expression": "0.8 + fulgora_rock * 2 - max(0, fulgora_mix_oil) * 6"
  },
  "fulgoran-walls": {
   "name": "fulgoran-walls",
   "expression": "fulgora_tile_ruin_walls"
  },
  "fulgoran-conduit": {
   "name": "fulgoran-conduit",
   "expression": "fulgora_tile_ruin_conduit"
  },
  "fulgoran-machinery": {
   "name": "fulgoran-machinery",
   "expression": "fulgora_tile_ruin_machinery"
  }
 },
 "resource_autoplace_overrides": {
  "scrap": {
   "control": "scrap",
   "local_expressions": {
    "abs_mult_height_over": "fulgora_elevation > (fulgora_coastline + 10)",
