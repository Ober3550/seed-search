# Environment configuration for the SE seed finder.
# Copy this file to .env and edit the values for your machine.
# The .env file is sourced by verify-seed.sh and other scripts.

# --- Factorio (used by the verifier) ---

# Path to the Factorio executable.
# macOS: /Applications/factorio.app/Contents/MacOS/factorio
# Steam: ~/Library/Application Support/Steam/steamapps/common/Factorio/factorio.app/Contents/MacOS/factorio
FACTORIO_BIN="/Applications/factorio.app/Contents/MacOS/factorio"

# Path to the Factorio user-data directory (where mods/ lives).
# Default is OS-specific; set this only if yours is non-standard.
# FACTORIO_HOME="${HOME}/Library/Application Support/factorio"

# RCON settings for the headless server spun up by ingame_dump.py.
# Change these if the defaults clash with a running game.
# RCON_PORT=27717
# GAME_PORT=34717
# RCON_PASSWORD=seedsearch

# --- Lua interpreter (used by the verifier & runner) ---

# Command that runs the repo's bundled Lua interpreter.
# Native Linux / x86_64:   runner/bin/lua
# Docker (Apple Silicon):  docker run --rm --platform linux/amd64 -v "${REPO}:/w" -w /w --entrypoint /w/runner/bin/lua-linux-x86_64 seedlua
# Leave unset to auto-detect (native first, then docker fallback).
# SEED_LUA="runner/bin/lua"

# --- Mod set ---

# Set to 1 to enable Krastorio2 support.
# When enabled, K2 must also be active in Factorio's mod set for verification.
SE_ENABLE_K2=0

# --- Runner parallelism ---

# Number of parallel worker processes for the distributed seed finder.
# Defaults to the number of CPU cores (capped at 128).
# WORKER_COUNT=8
